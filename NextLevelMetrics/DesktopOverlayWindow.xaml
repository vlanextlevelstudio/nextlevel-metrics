<Window x:Class="NextLevelMetrics.DesktopOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Left="0"
        Top="0">
    <Border x:Name="OverlayBorder" Padding="8,5" Background="Transparent" CornerRadius="4">
        <TextBlock x:Name="MetricsText"
                   Text="FPS -- | CPU -- | GPU -- - --"
                   Foreground="White"
                   FontFamily="Segoe UI Semibold"
                   FontSize="17"
                   TextWrapping="NoWrap">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.9" />
            </TextBlock.Effect>
        </TextBlock>
    </Border>
</Window>
